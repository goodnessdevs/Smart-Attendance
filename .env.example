# Copy to .env.local for development, and set these in your hosting provider
# (Vercel: Project Settings > Environment Variables) for deployments.

# ---------------------------------------------------------------------------
# Server-only. These are never sent to the browser — the client talks to this
# app's own /api routes, which forward to the backend with the session token
# attached server-side.
# ---------------------------------------------------------------------------

# Base URL of the attendance API, with no trailing slash.
BACKEND_URL=https://your-backend.example.com

# Where the OAuth popup is sent to start Google sign-in.
GOOGLE_AUTH_URL=https://your-backend.example.com/auth/google

# Name of the httpOnly session cookie. Optional; defaults to the value below.
SESSION_COOKIE_NAME=smartendance_session

# ---------------------------------------------------------------------------
# Public. Inlined into the browser bundle — nothing secret here.
# ---------------------------------------------------------------------------

# Origin of the backend, used ONLY to validate postMessage events from the
# OAuth popup. Must be the scheme + host of BACKEND_URL, with no path.
#
# Once the backend's OAuth redirect points at /api/auth/callback instead of
# posting the token to window.opener, this can be removed entirely.
NEXT_PUBLIC_BACKEND_ORIGIN=https://your-backend.example.com
